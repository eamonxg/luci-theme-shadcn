    {% if (!blank_page): %}
      </div>{# /maincontent #}
    </div>{# /content-card #}
    </div>{# /main-wrapper #}

    <script>
      window.ShadcnSidebar = null;
      window.ShadcnMenu = null;
      L.require('sidebar-shadcn').then(function (m) {
        window.ShadcnSidebar = m;
      });
      L.require('menu-shadcn').then(function (m) {
        window.ShadcnMenu = m;
        if (window.navigation) L.require('router-shadcn');
      });
    </script>
    {% endif %}
  </body>
</html>
